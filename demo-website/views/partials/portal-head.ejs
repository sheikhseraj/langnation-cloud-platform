<!DOCTYPE html>
<html lang="en" data-theme-default data-ground="<%= site.ground %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · LangNation</title>
<%# The portal is private to one person: never indexed, never cached by a
    shared proxy. The route sets the same thing as a header. %>
<meta name="robots" content="noindex,nofollow">
<meta name="theme-color" content="<%= site.groundColor %>" media="(prefers-color-scheme: light)">
<%# The seal, not a simplified mark: see tools/favicon.js. The larger
    sizes are for HiDPI screens, which render a 32px tab slot at 64
    real pixels — without them the browser upscales and the icon looks
    soft. /favicon.ico is also served from the root, because browsers
    and Google ask for it there regardless of these tags. %>
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png">
<link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/icons/favicon-48.png" sizes="48x48" type="image/png">
<link rel="icon" href="/icons/favicon-96.png" sizes="96x96" type="image/png">
<link rel="icon" href="/icons/favicon-128.png" sizes="128x128" type="image/png">
<script>
(function () {
  try {
    var t = localStorage.getItem("ln-theme");
    if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
  } catch (e) {}
})();
</script>
<link rel="stylesheet" href="/css/site.css?v=<%= site.assetVersion %>">
</head>
<body<%- locals.readingWorkspace?' class="reading-workspace-page"':'' %>>

<header class="site-header portal-header">
  <div class="wrap header-inner">
    <%- include("brand", {}) %>
    <div class="header-actions">
      <a class="icon-btn" href="/" aria-label="Main website" title="Main website"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V10Z"/></svg></a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch theme">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" aria-hidden="true" data-icon-sun>
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-icon-moon hidden>
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
        </svg>
      </button>
      <% if (student) { %>
        <button class="icon-btn portal-menu-toggle" type="button" data-portal-nav-toggle aria-label="Portal-Menü" title="Portal-Menü" aria-expanded="false" aria-controls="portal-navigation" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></button>
        <%#
          The face, not the name. On a phone the name pushed Sign out
          off the row, and a person already knows who they are — what
          they need is the way back to their dashboard, which is what
          this is. The name still reaches a screen reader and still
          appears on hover.

          The locals come from the portal shell; the sign-in and
          account-closed pages include this header without them, so
          each is defaulted rather than assumed.
        %>
        <% const _av = typeof avatarUrl !== "undefined" ? avatarUrl : null; %>
        <% const _in = typeof initials !== "undefined" ? initials : (student.name || "?").trim().charAt(0).toUpperCase(); %>
        <% const _hu = typeof hue !== "undefined" ? hue : 210; %>
        <a class="icon-btn sp-homelink" href="/portal/me"
           aria-label="Dashboard — <%= student.name %>" title="Dashboard — <%= student.name %>">
          <%- include("portal-avatar", {
            avatarUrl: _av, initials: _in, hue: _hu, size: "sm", name: student.name,
          }) %>
        </a>
        <form method="post" action="/portal/logout" style="display:inline">
          <button class="icon-btn portal-signout" type="submit" aria-label="Sign out" title="Sign out"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4H4v16h5M14 8l4 4-4 4M8 12h13"/></svg></button>
        </form>
      <% } else { %>
        <a class="btn btn-ghost btn-sm" href="/">Back to site</a>
      <% } %>
    </div>
  </div>
</header>

<main id="main">
