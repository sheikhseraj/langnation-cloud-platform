</main>

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <%# The footer is navy in both themes, so the white logo always. %>
        <%- include("brand", { href: lp("/"), footer: true }) %>
        <p><%= t("site.description") %></p>
        <div class="social">
          <a href="<%= site.social.facebook %>" rel="noopener" aria-label="Facebook" target="_blank">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.25-1.5 1.55-1.5h1.65V4.6A22 22 0 0 0 14.3 4.5c-2.4 0-4 1.45-4 4.15v2.25H7.6V14h2.7v8z"/></svg>
          </a>
          <a href="<%= site.social.instagram %>" rel="noopener" aria-label="Instagram" target="_blank">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="<%= site.social.linkedin %>" rel="noopener" aria-label="LinkedIn" target="_blank">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.05a4.2 4.2 0 0 1 3.75-2c4 0 4.75 2.6 4.75 6V21h-4v-5.2c0-1.25 0-2.85-1.75-2.85s-2 1.35-2 2.75V21h-4z"/></svg>
          </a>
          <a href="<%= site.social.youtube %>" rel="noopener" aria-label="YouTube" target="_blank">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.75-1.75C18.25 5 12 5 12 5s-6.25 0-7.85.45A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.75 1.75C5.75 19 12 19 12 19s6.25 0 7.85-.45a2.5 2.5 0 0 0 1.75-1.75A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15V9l5.2 3z"/></svg>
          </a>
        </div>
      </div>

      <a class="footer-dict" href="<%= site.dictionaryUrl %>" target="_blank" rel="noopener noreferrer">
        <span class="footer-dict-art" aria-hidden="true">
          <span class="footer-dict-art-language">DE <span>⇄</span> EN</span>
          <span class="footer-dict-art-word">lernen<span>to learn</span></span>
          <span class="footer-dict-art-sound"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m11 5-5 4H3v6h3l5 4zM16 8a6 6 0 0 1 0 8M19 5a10 10 0 0 1 0 14"/></svg></span>
        </span>
        <span class="footer-dict-text">
          <span class="footer-dict-badge"><%= t("dict.badge") %></span>
          <b><%= t("dict.name") %></b>
          <span class="footer-dict-pitch"><%= t("dict.footerPitch") %></span>
          <span class="footer-dict-features">
            <% ["iPron", "iExamples", "iCards"].forEach(feature => { %><span><%= t("dict." + feature) %></span><% }); %>
          </span>
        </span>
        <span class="footer-dict-go"><%= t("dict.open") %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg><span class="sr-only"> (<%= t("nav.newTab") %>)</span></span>
      </a>

      <nav class="footer-links" aria-label="<%= t('footer.navigation') %>">
        <details class="footer-group" data-responsive-menu data-menu-breakpoint="650" open>
          <summary><h4><%= t("footer.courses") %></h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
          <ul>
          <% footerTracks.forEach(function (tr) { %>
            <li><a href="<%= lp('/courses') %>?track=<%= encodeURIComponent(tr) %>"><%= t("courses.track." + tr) %></a></li>
          <% }); %>
          <li><a href="<%= lp('/courses') %>"><%= t("cta.viewCourses") %></a></li>
        </ul>
        </details>
        <details class="footer-group" data-responsive-menu data-menu-breakpoint="650" open>
          <summary><h4><%= t("footer.learn") %></h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
          <ul>
          <li><a href="<%= lp('/einbuergerungstest') %>">Einbürgerungstest</a></li>
          <li><a href="<%= lp('/placement-test') %>"><%= t("nav.placement") %></a></li>
          <li><a href="<%= lp('/exam-papers') %>"><%= t("nav.exams") %></a></li>
          <li><a href="<%= lp('/study-material') %>"><%= t("nav.resources") %></a></li>
          <li><a href="<%= lp('/germany') %>"><%= t("nav.germany") %></a></li>
          <%# The four calculators had exactly one route to them: the
              last line of the Germany menu. A grade converter is
              something people come looking for, so it gets a second. %>
          <li><a href="<%= lp('/tools') %>"><%= t("nav.tools") %></a></li>
        </ul>
        </details>
        <details class="footer-group" data-responsive-menu data-menu-breakpoint="650" open>
          <summary><h4><%= t("footer.institute") %></h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
          <ul>
          <li><a href="<%= lp('/about') %>"><%= t("nav.about") %></a></li>
          <li><a href="<%= lp('/contact') %>"><%= t("nav.contact") %></a></li>
          <li><a href="<%= lp('/faq') %>"><%= t("nav.faq") %></a></li>
          <li><a href="<%= lp('/blog') %>"><%= t("nav.blog") %></a></li>
          <li><a href="/portal"><%= t("nav.portal") %></a></li>
        </ul>
        </details>
      </nav>
    </div>

    <div class="footer-bottom">
      <span>© <%= year %> <%= t("footer.builtBy") %> <%= t("footer.rights") %></span>
      <%# The legal pages moved down here. They are required, not
          browsed — nobody scans a footer column for "Impressum", they
          come looking for it. %>
      <a href="<%= lp('/community') %>"><%= lang === "de" ? "WhatsApp-Community" : "WhatsApp Community" %></a>
      <nav class="footer-legal" aria-label="<%= t('footer.legal') %>">
        <a href="<%= lp('/privacy-policy') %>">Privacy</a>
        <a href="<%= lp('/delete-account') %>"><%= lang === "de" ? "Konto löschen" : "Delete account" %></a>
        <a href="<%= lp('/terms-and-conditions') %>">Terms</a>
        <a href="<%= lp('/imprint') %>">Impressum</a>
        <a href="<%= lp('/legal-disclosure') %>">Legal notice</a>
      </nav>
      <span class="footer-motto"><%= t("site.motto") %></span>
    </div>
  </div>
</footer>

<%# The assistant, after the footer so it sits above everything without
    being inside anything that scrolls. Only when a key is configured:
    a chat bubble that opens and apologises is worse than no bubble. %>
<% if (site.chat && site.chat.on) { %>
  <%- include("chat-widget", { lang: lang, lp: lp, site: site }) %>
  <script src="/js/chat-position.js?v=<%= site.assetVersion %>" defer></script>
<% } %>

<script src="/js/app.js?v=<%= site.assetVersion %>" defer></script>
<%# A page may ask for one script or several. Several matters where the
    page's logic is split into a testable core plus its user interface,
    so the core can be require()d by the test suite. %>
<% if (typeof pageScript !== "undefined" && pageScript) { %>
<script src="/js/<%= pageScript %>?v=<%= site.assetVersion %>" defer></script>
<% } %>
<% if (typeof pageScripts !== "undefined" && Array.isArray(pageScripts)) { %>
<% pageScripts.forEach(function (src) { %>
<script src="/js/<%= src %>?v=<%= site.assetVersion %>" defer></script>
<% }); %>
<% } %>
</body>
</html>
