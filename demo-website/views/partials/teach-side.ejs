<%#
  The teacher's own navigation, with their face at the top of it.

  Short on purpose. A teacher opens this between lessons, on a phone,
  to find one of four things: what is happening now, who is in the
  class, when the next one is, and their own password. Anything else
  belongs in the office's back room, not here.

  Expects: nav, teacher, avatarUrl, initials, hue.
%>
<%
  const items = [
    ["dashboard", "/teach/me",       "Dashboard"],
    ["batches",    "/teach/batches",    "My classes"],
    ["attendance", "/teach/attendance", "Attendance"],
    ["homework",   "/teach/homework",   "Aufgaben"],
    ["progress",  "/teach/progress", "Class progress"],
    ["schedule",  "/teach/schedule", "Schedule"],
    ["settings",  "/teach/settings", "Settings"],
  ];
  const icons = {
    dashboard: '<path d="M4 4h7v7H4zM13 4h7v4h-7zM13 11h7v9h-7zM4 14h7v6H4z"/>',
    batches:   '<path d="M17 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9.5" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9"/><path d="M16 3.1a4 4 0 0 1 0 7.8"/>',
    // A pencil on a page. Everything else here is something to read;
    // this is the one you set.
    homework:  '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h9"/>'
             + '<path d="M8 8h5M8 12h3"/>'
             + '<path d="m19 12 3 3-4.5 4.5-3.2.7.7-3.2z"/>',
    // A list with a tick against it: the page is a term to tick off.
    attendance: '<path d="M3 5h18v16H3z"/><path d="M3 9h18M8 3v4M16 3v4"/>'
              + '<path d="m8.5 14 2 2 4-4"/>',
    progress:  '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
    schedule:  '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
    settings:  '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.9 1.2 2 2 0 1 1-4 0 1.7 1.7 0 0 0-2.9-1.2l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.7 1.7 0 0 0 3 15a2 2 0 1 1 0-4 1.7 1.7 0 0 0 1.2-2.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1A1.7 1.7 0 0 0 10 4.1a2 2 0 1 1 4 0 1.7 1.7 0 0 0 2.9 1.2l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1A1.7 1.7 0 0 0 21 11a2 2 0 1 1 0 4z"/>',
  };
%>
<details id="portal-navigation" class="sp-global-nav" data-responsive-menu data-menu-breakpoint="900" open>
 <summary class="sp-global-title"><span><strong><%= teacher.name %></strong><small>Teacher portal menu</small></span><svg class="material-menu-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></summary>
<aside class="sp-side">
  <div class="sp-me">
    <%- include("portal-avatar", {
      avatarUrl: avatarUrl, initials: initials, hue: hue,
      size: "lg", name: teacher.name,
    }) %>
    <p class="sp-me-name"><%= teacher.name %></p>
    <%# The reference once there is one — it is what the office will
        quote — and the role until then. %>
    <p class="sp-me-ref">
      <%= teacher.teacher_ref || (teacher.role === "teacher" ? "Teacher" : teacher.role) %>
    </p>
  </div>

  <nav aria-label="Teacher portal">
    <ul class="sp-nav">
      <% items.forEach(function (it) { %>
        <li>
          <a href="<%= it[1] %>"<%- nav === it[0] ? ' aria-current="page"' : "" %>>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- icons[it[0]] %></svg>
            <%= it[2] %>
          </a>
        </li>
      <% }); %>
      <li>
        <%# A form, not a link: signing out changes something, and a
            link that changes something is fetched by every crawler and
            link-preview bot that sees it. %>
        <form method="post" action="/teach/logout">
          <button type="submit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/>
            </svg>
            Sign out
          </button>
        </form>
      </li>
    </ul>
  </nav>
</aside>

</details>
