<%#
  A password box with a show/hide eye.

  The eye is added by app.js, not by this markup, and that is the point:
  without JavaScript there is no button, because a button that cannot
  reveal anything is worse than no button. The wrapper and the data
  attribute are the only thing here — everything visible is an ordinary
  password input until the script upgrades it.

  Long passphrases are what the rules ask for, and a long passphrase is
  exactly what people mistype into a field they cannot see. Being able
  to look is the difference between choosing a good password and
  choosing a short one.

  Expects: id, name, label.
  Optional: autocomplete (default "current-password"), hint, error,
            minlength, required (default true), autofocus.
%>
<%
  const _auto = typeof autocomplete === "undefined" ? "current-password" : autocomplete;
  const _min = typeof minlength === "undefined" ? null : minlength;
  const _req = typeof required === "undefined" ? true : required;
  const _err = typeof error === "undefined" ? null : error;
  const _hint = typeof hint === "undefined" ? null : hint;
%>
<div class="field">
  <label for="<%= id %>"><%= label %></label>
  <div class="pw" data-password>
    <input type="password" id="<%= id %>" name="<%= name %>"
           autocomplete="<%= _auto %>" maxlength="200"
           <%- _min ? ` minlength="${_min}"` : "" %>
           <%- _req ? " required" : "" %>
           <%- typeof autofocus !== "undefined" && autofocus ? " autofocus" : "" %>
           <%- _err ? ` aria-invalid="true" aria-describedby="err-${id}"` : "" %>>
  </div>
  <% if (_err) { %><p class="field-error" id="err-<%= id %>"><%= _err %></p><% } %>
  <% if (_hint) { %><p class="field-hint"><%= _hint %></p><% } %>
</div>
