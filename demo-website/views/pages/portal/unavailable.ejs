<%- include("../../partials/portal-head", { title: "Portal unavailable" }) %>

<section class="section-tight">
  <div class="wrap wrap-narrow center">
    <p class="eyebrow">Student portal</p>
    <h1>Not available yet</h1>
    <%# Shown instead of a 500 when DB_* is unset. The portal is the only
        part of the site that cannot fall back to the JSON content files,
        so it says so plainly rather than failing obscurely. %>
    <p class="lead"><%= error %></p>
    <p class="muted" style="margin-top:1.5rem;font-size:.9rem">
      Everything else on the site works normally.
      <a href="/contact">Contact us</a> and we will help directly.
    </p>
  </div>
</section>

<%- include("../../partials/portal-foot") %>
