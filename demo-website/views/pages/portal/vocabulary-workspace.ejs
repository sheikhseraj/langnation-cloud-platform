<%- include('../../partials/vocabulary-shell-head',{vocabularyWorkspace:true}) %>
<div class="v-vocabulary v-workspace" id="vocabulary-learning" lang="de" data-view="workspace" data-csrf="<%= csrf %>" data-student="<%= student.id %>">
<script id="v-workspace-data" type="application/json"><%- JSON.stringify({config:workspaceConfig,catalogue,ready:learningReady}).replace(/</g,'\\u003c') %></script>
<div class="v-inner-layout"><div class="material-mobile-tools"><nav class="v-panel v-block-nav" aria-label="Meine Vokabelblöcke"><details id="v-block-nav-details" data-responsive-menu data-menu-breakpoint="859" open><summary><span id="v-navigation-title">Wortschatz</span><%- icons.icon('right') %></summary><div id="v-block-navigation"></div></details></nav><div class="material-mobile-back"><%- include('../../partials/vocabulary-breadcrumbs') %></div></div>
<section class="v-study-main"><%- include('../../partials/vocabulary-breadcrumbs') %><header class="v-page-heading"><span class="v-eyebrow" id="v-workspace-eyebrow">WORTSCHATZ</span><h1 id="v-workspace-title">Lerneinheit wird geladen…</h1><p id="v-workspace-selection" class="v-selection-caption" hidden></p><p>Lerne die Wörter, entdecke die Lösung und bewerte dein Wissen.</p></header><p id="v-status" class="v-status" role="status" aria-live="polite"></p>
<div class="v-mode-tabs" role="tablist" aria-label="Lernmodus"><% for(const [mode,label,icon] of [['learn','Lernen','book'],['flashcards','Flashcards','cards'],['quiz','Quiz','quiz'],['writing','Schreiben','pen']]){ %><button type="button" role="tab" id="v-tab-<%= mode %>" data-mode="<%= mode %>" aria-controls="v-study-card" aria-selected="false" tabindex="-1"><%- icons.icon(icon) %><span><%= label %></span></button><% } %></div>
<div id="v-study-card" class="v-study-card" role="tabpanel" aria-labelledby="v-tab-learn"></div><p id="v-session-caption" class="v-session-caption" role="status"></p>
<p id="v-mode-help" class="v-hint" role="status" hidden></p>
<nav id="v-bottom-nav" class="v-bottom-nav" aria-label="Lernnavigation"><button type="button" class="v-button v-button-quiet" id="v-previous" disabled><%- icons.icon('left') %>Vorherige</button><button type="button" class="v-button v-button-quiet" id="v-help" aria-controls="v-mode-help" aria-expanded="false" disabled><%- icons.icon('quiz') %><span>Hilfe</span></button><button type="button" class="v-button" id="v-check" hidden disabled><%- icons.icon('checkCircle') %>Prüfen</button><button type="button" class="v-button v-button-quiet" id="v-reveal" hidden disabled><%- icons.icon('eye') %>Lösung zeigen</button><button type="button" class="v-button" id="v-next" disabled><span>Nächste</span><%- icons.icon('right') %></button></nav>
<noscript>Bitte aktiviere JavaScript, um die interaktiven Übungen zu bearbeiten. Dein gespeicherter Fortschritt bleibt erhalten.</noscript>
</section>
<aside class="v-panel v-progress-nav" aria-label="Fortschritt auf dieser Seite"><h2>Auf dieser Seite</h2><progress id="v-session-progress" value="0" max="1" aria-label="Bearbeitete Vokabeln"></progress><p id="v-progress-caption">0 bearbeitet</p><ol id="v-progress-list"></ol></aside></div>
</div>
<script src="/js/study-icons.js?v=<%= site.assetVersion %>" defer></script><script src="/js/vocabulary-ui.js?v=<%= site.assetVersion %>" defer></script><script src="/js/vocabulary-learning.js?v=<%= site.assetVersion %>" defer></script>
<%- include('../../partials/portal-shell-foot') %>
