<%- include("../../partials/portal-head", { title: "Choose your password" }) %>

<section class="section-tight">
  <div class="wrap wrap-narrow">
    <p class="eyebrow">Student portal</p>
    <h1>Welcome, <%= invite.name %></h1>
    <p class="lead">
      Your account has been approved. Choose a password and you are in —
      there is nothing else to confirm.
    </p>

    <%#
      Name and email are shown but not editable. They come from the
      approved request, not from this form, so an intercepted link cannot
      be turned into an account for somebody else.
    %>
    <div class="facts" style="margin-top:1.5rem">
      <h3>Your account</h3>
      <dl>
        <div><dt>Name</dt><dd><%= invite.name %></dd></div>
        <div><dt>Email</dt><dd><%= invite.email %></dd></div>
      </dl>
    </div>

    <form class="form" method="post" action="/portal/invite/<%= encodeURIComponent(token) %>" style="margin-top:1.5rem">
      <%- include("../../partials/password-field", {
        id: "password", name: "password", label: "Choose a password",
        autocomplete: "new-password", minlength: 10,
        error: errors.password || null,
        hint: "At least ten characters. A few unrelated words are easier to remember than a short jumble, and harder to guess.",
      }) %>

      <%# The same gate the teacher invitation uses, and the same one
          on the account-request form: the terms open in a dialog and
          Accept wakes up at the bottom of them. %>
      <%- include("../../partials/terms-gate", {
        termsTitle: termsTitle, termsPath: termsPath, termsHtml: termsHtml,
        acceptError: errors.accept || null,
      }) %>

      <button class="btn btn-block" type="submit" style="margin-top:1.25rem">Create my account</button>
    </form>

    <p class="muted" style="font-size:.88rem;margin-top:1.5rem">
      This link works once. If something goes wrong,
      <a href="/contact">tell the office</a> and we will send a new one.
    </p>
  </div>
</section>

<%- include("../../partials/portal-foot") %>
