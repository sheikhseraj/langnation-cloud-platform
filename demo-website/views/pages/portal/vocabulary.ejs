<% const vocabularyAvailable=typeof learningReady!=='undefined'&&learningReady; %>
<%- include('../../partials/vocabulary-shell-head') %>
<div class="v-vocabulary v-dashboard" id="vocabulary-learning" lang="de" data-view="dashboard" data-csrf="<%= csrf %>" data-student="<%= student.id %>">
 <header class="v-page-heading"><h1>Wortschatz</h1><p>Lerne neue Wörter Schritt für Schritt.</p><span id="v-overall-caption">Dein Wortschatz wird geladen…</span></header>
 <p id="v-status" class="v-status" role="status" aria-live="polite"></p>
 <% if(vocabularyAvailable){ %>
 <section class="v-summary" aria-label="Dein Vokabel-Fortschritt"><article><h2>Vokabel-Fortschritt</h2><div class="v-summary-value"><span class="v-icon-circle"><%- icons.icon('book') %></span><div><strong id="v-summary-learned">—</strong><small>Vokabeln gelernt</small></div></div><div class="v-meter-row"><progress id="v-overall-progress" max="100" value="0" aria-label="Gesamter Lernfortschritt"></progress><span id="v-overall-percent">—</span></div></article><article><h2>Aktuelle Serie</h2><div class="v-summary-value"><span class="v-icon-circle v-icon-gold"><%- icons.icon('flame') %></span><div><strong id="v-summary-streak">—</strong><small id="v-streak-caption">Dranbleiben!</small></div></div></article><article><h2>Tagesziel</h2><div class="v-summary-value"><span class="v-icon-circle v-icon-gold"><%- icons.icon('target') %></span><div><strong id="v-summary-goal">—</strong><small>heute geübt</small></div></div><div class="v-meter-row"><progress id="v-summary-goal-progress" value="0" max="10" aria-label="Tagesziel-Fortschritt"></progress><span id="v-summary-goal-percent">—</span></div></article></section>
 <div class="v-learning-paths"><section class="v-panel v-daily-card"><header class="v-card-heading"><span class="v-icon-circle"><%- icons.icon('target') %></span><div><h2>Tagesziel</h2><p>Setze dir ein tägliches Ziel und lerne neue Wörter in kleinen, effektiven Einheiten.</p></div></header><div class="v-card-body"><h3>Tägliches Ziel wählen</h3><div class="v-goal-options" role="group" aria-label="Tagesziel wählen"><% [5,10,15,20].forEach(n=>{ %><button type="button" data-goal="<%= n %>" aria-pressed="false"><%= n %></button><% }) %><button id="v-custom-toggle" type="button" aria-expanded="false" aria-controls="v-custom-goal">Eigenes Ziel</button></div><form id="v-custom-goal" class="v-custom-goal" hidden><label for="v-custom-input">Wörter pro Tag (1–100)</label><div><input id="v-custom-input" type="number" min="1" max="100" step="1" required><button class="v-button" type="submit">Übernehmen</button></div></form><button class="v-text-button" id="v-add-goal" type="button"><%- icons.icon('plus') %>Mehr hinzufügen</button><div class="v-daily-progress"><h3>Dein heutiger Fortschritt</h3><div class="v-progress-label"><strong id="v-goal-caption">—</strong><span id="v-goal-percent">—</span></div><progress id="v-goal-progress" value="0" max="10" aria-label="Heute geübte Wörter"></progress></div><div class="v-goal-complete" id="v-goal-complete" hidden><%- icons.icon('checkCircle') %><div><strong>Tagesziel geschafft!</strong><p>Möchtest du noch 10 weitere Wörter lernen?</p><button class="v-button v-button-quiet" id="v-next-ten" type="button">Nächste 10 starten</button></div></div><p class="v-due-caption" id="v-due-caption"></p></div><button class="v-button v-path-start" id="v-start-daily" type="button"><%- icons.icon('play') %>Tagesziel starten</button></section>
 <section class="v-panel"><header class="v-card-heading"><span class="v-icon-circle"><%- icons.icon('book') %></span><div><h2>Alle Vokabeln lernen</h2><p>Lerne den kompletten Wortschatz systematisch nach Niveau und in übersichtlichen Blöcken.</p></div></header><div class="v-card-body"><h3>Niveau wählen</h3><p class="v-help">Wähle dein Sprachniveau, um die passenden Vokabeln zu sehen.</p><div class="v-level-options" role="group" aria-label="Niveau wählen"><button type="button" data-level="" aria-pressed="true">Alle</button><% catalogue.levels.forEach(level=>{ %><button type="button" data-level="<%= level %>" aria-pressed="false"><%= level %></button><% }) %></div><div class="v-block-section"><h3>Vokabelblock wählen</h3><p class="v-help">Lerne in übersichtlichen Blöcken mit bis zu 50 Wörtern.</p><div class="v-block-options" id="v-blocks" role="group" aria-label="Vokabelblock wählen" aria-busy="true"></div><div class="v-block-selection" id="v-block-selection"><%- icons.icon('book') %><div><strong id="v-block-title">Alle Niveaus · Vokabelblock</strong><small>Dein nächster Schritt im Wortschatz.</small></div><span id="v-block-count"></span></div></div></div><button class="v-button v-path-start" id="v-start-block" type="button" disabled><%- icons.icon('play') %>Vokabelblock starten</button></section></div>
 <section class="v-panel v-filter-panel"><div class="v-section-heading"><h2><%- icons.icon('filter') %>Vokabeln auswählen</h2><span class="v-help" id="v-filter-level-context">Niveau: Alle Niveaus</span></div><form id="v-filters" action="/portal/vocabulary/learn" method="get"><input type="hidden" name="kind" value="filtered"><input type="hidden" name="level" value=""><div class="v-filters"><% for(const [key,label,items] of [['theme','Thema',catalogue.themes],['grammar','Grammatik',catalogue.grammar],['type','Wortart',catalogue.types]]){ %><label><span><%= label %></span><select name="<%= key %>"><option value="">Alle <%= key==='level'?'Niveaus':key==='theme'?'Themen':key==='grammar'?'Grammatikthemen':'Wortarten' %></option><% Object.entries(items).forEach(([id,name])=>{ %><option value="<%= id %>" data-label="<%= name %>"><%= name %></option><% }) %></select></label><% } %><button type="button" class="v-button v-button-quiet v-button-small" id="v-filter-reset"><%- icons.icon('refresh') %>Filter zurücksetzen</button></div><label class="v-search"><%- icons.icon('search') %><input type="search" name="q" maxlength="100" placeholder="Vokabel suchen…" aria-label="Vokabel suchen"></label><div class="v-filter-start"><div><strong id="v-filter-count" role="status">Auswahl wird geladen…</strong><p class="v-help" id="v-filter-caption">Wähle deine Filter und starte eine eigene Lerneinheit.</p></div><button class="v-button" id="v-start-filtered" type="submit" disabled><%- icons.icon('play') %>Lernen starten</button></div></form></section>
 <section class="v-panel v-collections"><div class="v-section-heading"><h2>Meine Sammlung</h2><span id="v-result-count" role="status"></span></div><div class="v-collection-tabs" role="group" aria-label="Sammlung auswählen"><% for(const [key,label] of [['all','Alle'],['saved','Gespeichert'],['difficult','Schwierige Wörter'],['due','Zu wiederholen']]){ %><button type="button" data-collection="<%= key %>" aria-pressed="<%= key==='all'?'true':'false' %>"><%= label %></button><% } %></div><p class="v-help" id="v-collection-caption">Wähle deine gespeicherten oder bereits geübten Wörter. Die Lernkarten öffnen sich auf der nächsten Seite.</p><button type="button" class="v-button v-path-start" id="v-start-collection" disabled><%- icons.icon('play') %>Sammlung üben</button></section>
 <% }else{ %><div class="v-panel"><h2>Vokabeln sind gerade nicht verfügbar.</h2><p>Bitte versuche es später erneut. Deine gespeicherten Wörter findest du unten.</p></div><% } %>
</div>
<% if(words.length || !vocabularyAvailable){ %><details class="v-panel v-legacy" <%= !vocabularyAvailable?'open':'' %>><summary>Vokabeln aus Lesen</summary><div id="vocabulary-list" data-csrf="<%= csrf %>"><p id="vocabulary-status" role="status"></p><% if(!words.length){ %><p class="v-help">Noch keine Wörter gespeichert.</p><% } %><% words.forEach(w=>{ %><article class="v-saved-word"><h3><%= w.headword %></h3><p><%= w.meaning %></p><% if(w.source_context){ %><details><summary>Lesekontext</summary><p><%= w.source_context %></p></details><% } %><div class="v-word-actions"><a class="v-button v-button-quiet" href="https://langnation.de/?q=<%= encodeURIComponent(w.headword) %>">Im Dictionary öffnen</a><button class="v-button v-button-quiet" type="button" data-remove-word="<%= w.id %>">Entfernen</button></div></article><% }) %></div></details><% } %>
<script src="/js/study-icons.js?v=<%= site.assetVersion %>" defer></script><script src="/js/vocabulary-ui.js?v=<%= site.assetVersion %>" defer></script><script src="/js/vocabulary-select.js?v=<%= site.assetVersion %>" defer></script><script src="/js/vocabulary-dashboard.js?v=<%= site.assetVersion %>" defer></script><script src="/js/reading.js?v=<%= site.assetVersion %>" defer></script>
<%- include('../../partials/portal-shell-foot') %>
