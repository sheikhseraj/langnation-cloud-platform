<%- include("../partials/head") %>
<%- include("../partials/header") %>

<section class="section-tight">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow"><%= t("nav.team") %></p>
      <h1><%= t("team.title") %></h1>
      <p class="lead"><%= t("team.lead") %></p>
    </div>

    <div class="grid grid-4">
      <% team.forEach(function (p) { %>
        <article class="card person">
          <div class="person-photo">
            <% if (p.image) { %>
              <img src="<%= p.image.src %>"
                   <% if (p.image.srcset) { %>srcset="<%= p.image.srcset %>" sizes="(min-width:1120px) 240px, 45vw"<% } %>
                   width="480" height="480" loading="lazy" decoding="async" alt="<%= p.name %>">
            <% } else { %>
              <img src="/icons/crest.png?v=<%= site.assetVersion %>" width="64" height="64" alt="" aria-hidden="true" class="person-fallback">
            <% } %>
          </div>
          <div class="card-body">
            <h2 class="person-name"><%= p.name %></h2>
            <p class="person-role"><%= p.role %></p>
            <% if (p.excerpt) { %><p class="person-bio"><%= p.excerpt %></p><% } %>

            <% if (p.linkedin || p.twitter || p.facebook || p.email) { %>
              <div class="person-links">
                <% if (p.linkedin) { %>
                  <a href="<%= p.linkedin %>" rel="noopener nofollow" target="_blank" aria-label="<%= p.name %> on LinkedIn">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.05a4.2 4.2 0 0 1 3.75-2c4 0 4.75 2.6 4.75 6V21h-4v-5.2c0-1.25 0-2.85-1.75-2.85s-2 1.35-2 2.75V21h-4z"/></svg>
                  </a>
                <% } %>
                <% if (p.twitter) { %>
                  <a href="<%= p.twitter %>" rel="noopener nofollow" target="_blank" aria-label="<%= p.name %> on X">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.2 2h3.3l-7.2 8.2L22.5 22h-6.6l-5.2-6.8L4.7 22H1.4l7.7-8.8L1.1 2h6.8l4.8 6.4zm-1.2 18h1.8L6.9 3.9H5z"/></svg>
                  </a>
                <% } %>
                <% if (p.facebook) { %>
                  <a href="<%= p.facebook %>" rel="noopener nofollow" target="_blank" aria-label="<%= p.name %> on Facebook">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.25-1.5 1.55-1.5h1.65V4.6A22 22 0 0 0 14.3 4.5c-2.4 0-4 1.45-4 4.15v2.25H7.6V14h2.7v8z"/></svg>
                  </a>
                <% } %>
                <% if (p.email) { %>
                  <a href="mailto:<%= p.email %>" aria-label="Email <%= p.name %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="m3 6 9 6.5L21 6"/></svg>
                  </a>
                <% } %>
              </div>
            <% } %>
          </div>
        </article>
      <% }); %>
    </div>

    <div class="band" style="margin-top:3.5rem">
      <h2 style="font-size:clamp(1.4rem,3vw,1.9rem)"><%= t("home.ctaTitle") %></h2>
      <p><%= t("home.ctaLead") %></p>
      <a class="btn" href="<%= lp('/contact') %>"><%= t("cta.enquire") %></a>
    </div>
  </div>
</section>

<%- include("../partials/footer") %>
