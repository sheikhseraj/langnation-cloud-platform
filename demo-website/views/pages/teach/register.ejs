<%
  const day = (v) => (v
    ? new Date(v).toLocaleDateString("en-GB", { weekday: "short", day: "numeric", month: "short", year: "numeric" })
    : null);

  // The day before and after, for the arrows. Tomorrow is not offered
  // when it would be in the future — a register is a record of what
  // happened, and there is nothing yet to record.
  const shift = (iso, by) => {
    const d = new Date(iso + "T12:00:00Z");
    d.setUTCDate(d.getUTCDate() + by);
    return d.toISOString().slice(0, 10);
  };
  const prev = shift(date, -1);
  const next = shift(date, 1);
  const canGoForward = next <= today;

  const active = rows.filter((r) => r.enrolment_status === "active");
  const past = rows.filter((r) => r.enrolment_status !== "active");
%>
<%
  // Prefilled from where the lesson is NOW, read on a clock in the
  // batch's zone. Prefilling from the server's would offer a teacher a
  // 17:00 class that everyone else calls 19:00.
  const isoIn = (v, tz) => new Intl.DateTimeFormat("en-CA", {
    timeZone: tz || "Europe/Berlin",
    year: "numeric", month: "2-digit", day: "2-digit",
  }).format(new Date(v));

  const hhmmIn = (v, tz) => new Intl.DateTimeFormat("en-GB", {
    timeZone: tz || "Europe/Berlin",
    hour: "2-digit", minute: "2-digit", hour12: false,
  }).format(new Date(v));
%>
<%- include("../../partials/teach-shell-head", {
  pageTitle: "Register — " + day(date + "T12:00:00Z"),
  pageLead: (batch.course_title || batch.code) + " · " + batch.code
    + (taken
        ? " · already taken, saving again corrects it"
        : lesson ? " · not marked yet" : " · no class recorded for this day yet"),
  nav: "batches", teacher: teacher, avatarUrl: avatarUrl,
  initials: initials, hue: hue, notice: notice, error: error,
}) %>

<%# Moving between days without going back to the batch. Most registers
    are taken on the day; the ones that are not are usually yesterday's,
    remembered on the way home. %>
<div class="sp-card sp-wide">
  <div class="row" style="gap:.6rem;flex-wrap:wrap;align-items:center;justify-content:space-between">
    <div class="sp-daybar">
      <a class="btn btn-ghost btn-sm" href="/teach/batch/<%= batch.id %>/register?date=<%= prev %>">←
        <span class="sr-only">The day before</span>
      </a>
      <form method="get" action="/teach/batch/<%= batch.id %>/register" class="sp-daybar">
        <label class="sr-only" for="date">Date</label>
        <input type="date" id="date" name="date" value="<%= date %>" max="<%= today %>">
        <button class="btn btn-ghost btn-sm" type="submit">Go</button>
      </form>
      <% if (canGoForward) { %>
        <a class="btn btn-ghost btn-sm" href="/teach/batch/<%= batch.id %>/register?date=<%= next %>">→
          <span class="sr-only">The day after</span>
        </a>
      <% } %>
    </div>
    <a class="btn btn-ghost btn-sm" href="/teach/batch/<%= batch.id %>">Back to the class</a>
  </div>
</div>

<% if (!active.length) { %>
  <div class="sp-card sp-wide">
    <p class="sp-empty">
      Nobody is enrolled on <%= batch.code %>, so there is nobody to mark.
      The office adds students to a batch as they enrol.
    </p>
  </div>
<% } else { %>
  <form method="post" action="/teach/batch/<%= batch.id %>/register">
            <input type="hidden" name="_csrf" value="<%= locals.classJoinCsrf || '' %>">
    <%# The date, and nothing else. The form used to carry a lesson id
        too, which meant trusting a number anybody could edit; the
        server now works out which lesson that is, or creates it. %>
    <input type="hidden" name="date" value="<%= date %>">

    <div class="sp-card sp-wide">
      <div class="sp-card-head">
        <h2>Who was here</h2>
        <span class="muted" style="font-size:.85rem">
          <%= active.length %> <%= active.length === 1 ? "student" : "students" %>
        </span>
      </div>

      <%#
        Everybody starts on "Here" and the teacher changes the
        exceptions. A register that opens blank has to be filled in
        twenty times to say what is true nineteen times, and a register
        that takes that long does not get taken.

        Radios rather than a dropdown: on a phone, between lessons, one
        tap beats two. They work with no JavaScript at all — this whole
        page is an ordinary form post.
      %>
      <ul class="sp-list sp-register">
        <% active.forEach(function (s) { %>
          <li>
            <div class="sp-person">
              <%- include("../../partials/portal-avatar", {
                avatarUrl: s.photo, initials: s.initials, hue: s.hue,
                size: "sm", name: s.name,
              }) %>
              <div>
                <strong><%= s.name %></strong>
                <div class="muted" style="font-size:.8rem">
                  <% if (s.student_ref) { %><%= s.student_ref %><% } %>
                  <%#
                    Marked by their own click, or waiting for you.

                    Without this the register looks the same whether the
                    portal saw somebody or not, and the teacher cannot
                    tell which rows still need a decision — which is the
                    whole difficulty when half a class joins from a
                    calendar link the portal never sees.
                  %>
                  <% if (s.mark_source === "self") { %>
                    · <span class="sp-rate-good">joined from the portal</span>
                  <% } else if (s.mark_source === "teacher") { %>
                    · marked by you
                  <% } else { %>
                    · <span class="muted">not seen — set this one</span>
                  <% } %>
                </div>
              </div>
            </div>

            <div class="sp-marks" role="group" aria-label="Mark for <%= s.name %>">
              <% statuses.forEach(function (st) { %>
                <label class="sp-mark sp-mark-<%= st.tone %>">
                  <%#
                    Absent until something says otherwise.

                    It defaulted to Here, which meant a teacher who opened
                    the register and pressed save marked a full house —
                    including anybody who never turned up. The safe
                    default is the one that is wrong in the direction
                    somebody notices: a student marked absent who was
                    there will say so, and a student marked present who
                    was not says nothing at all.

                    A student who clicked Join already has a mark, and
                    that mark wins over the default. So the register
                    arrives pre-filled with whoever the portal saw, and
                    the teacher's job is the people it could not see —
                    which is the ones who joined from a calendar link.
                  %>
                  <input type="radio" name="status[s<%= s.id %>]" value="<%= st.key %>"
                         <%= (s.mark || "absent") === st.key ? "checked" : "" %>>
                  <span><%= st.label %></span>
                </label>
              <% }); %>
            </div>

            <%# Optional, and last. A note is the difference between
                "absent" and "absent, texted me, funeral" — which is the
                thing anybody reading this back in March will want. %>
            <input class="sp-mark-note" type="text" name="note[s<%= s.id %>]"
                   value="<%= s.note || "" %>" maxlength="300"
                   placeholder="Note (optional)"
                   aria-label="Note about <%= s.name %>">
          </li>
        <% }); %>
      </ul>

      <div class="row" style="gap:.6rem;margin-top:1.1rem;flex-wrap:wrap;align-items:center">
        <button class="btn" type="submit">
          <%= taken ? "Update the register" : "Save the register" %>
        </button>
        <% if (taken && rows.some((r) => r.marked_at)) { %>
          <span class="muted" style="font-size:.84rem">
            <%# In the batch's timezone, like every other time in the
                portal. Without it this printed the server's clock, which
                is UTC — two hours out from the room the class is in for
                half the year. %>
            Last saved <%= new Date(Math.max(...rows.filter((r) => r.marked_at).map((r) => new Date(r.marked_at)))).toLocaleString("en-GB", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: batch.timezone || "Europe/Berlin" }) %>
          </span>
        <% } %>
      </div>
    </div>

    <%# Students who have left the batch. Shown, because a register for
        a day they were still on it should still be correctable — but
        below the fold and clearly separated, so they are not marked out
        of habit. %>
    <% if (past.length) { %>
      <div class="sp-card sp-wide">
        <div class="sp-card-head">
          <h2>No longer on this batch</h2>
        </div>
        <p class="sp-empty" style="margin-bottom:.9rem">
          Left or finished. Mark them only for a day they were still attending.
        </p>
        <ul class="sp-list sp-register">
          <% past.forEach(function (s) { %>
            <li>
              <div class="sp-person">
                <div>
                  <strong><%= s.name %></strong>
                  <div class="muted" style="font-size:.8rem"><%= s.enrolment_status %></div>
                </div>
              </div>
              <div class="sp-marks" role="group" aria-label="Mark for <%= s.name %>">
                <% statuses.forEach(function (st) { %>
                  <label class="sp-mark sp-mark-<%= st.tone %>">
                    <input type="radio" name="status[s<%= s.id %>]" value="<%= st.key %>"
                           <%= s.mark === st.key ? "checked" : "" %>>
                    <span><%= st.label %></span>
                  </label>
                <% }); %>
              </div>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>
  </form>
<% } %>

<%#
  The class that did not happen.

  The backlog banner sends a teacher here to "take it now", and until
  this existed the only way to clear a register for a class that never
  ran was to mark everybody absent. That is not a correction; it is a
  false record of five people missing a lesson nobody taught, and it
  would follow them into their attendance rate and onto a certificate.

  Two different things, deliberately separate:

    Cancelled   it is not happening and is not being replaced. No
                register is owed and the students are told why.
    Postponed   it is happening, later. The lesson MOVES, keeping the
                note and where it came from, so a student who wrote the
                old time down is told what changed rather than finding
                a new class appear.

  Folded away, because on most days the register is the whole job and
  this is not.
%>
<% if (canChange && lesson && lesson.status !== "held") { %>
  <div class="sp-card sp-wide">
    <details class="tl-change">
      <summary>This class did not happen</summary>

      <form method="post" action="/teach/lesson/<%= lesson.id %>/cancel" class="tl-form tl-form-off">
      <%- include("../../partials/cancel-reason", { cancelReasons: cancelReasons }) %>
      <label class="field">
        <span>Anything to add</span>
        <input type="text" name="note" maxlength="<%= noteMax %>"
               placeholder="Nobody came, no notice given">
      </label>
        <%- include("../../partials/teach-notify", { canEmail: canEmail, verb: "the cancellation" }) %>
        <button class="btn btn-sm btn-ghost" type="submit">Cancel this class</button>
      </form>

      <%#
        Somebody else takes it, at the same time.

        A third thing, and genuinely different from the other two: the
        class happens, the students come, only the person at the front
        changes. Cancelling it and inventing a replacement would lose
        the register's history and tell the class the wrong thing.

        The list is every teacher account, not only this batch's cover.
        That is flexible, and the price is that a teacher can give a
        colleague sight of a class list by choosing a name — so the
        office is emailed every time, automatically, with who arranged
        it. Not a tick box: a record the person making the change
        cannot switch off.
      %>
      <% if (canHandOver && !lesson.stand_in_id) { %>
        <form method="post" action="/teach/lesson/<%= lesson.id %>/handover" class="tl-form">
          <input type="hidden" name="back" value="/teach/batch/<%= batch.id %>/register?date=<%= date %>">
          <p class="muted" style="margin:0;font-size:.84rem">
            Same time, same link. They can see this one class and take
            this register — nothing else on the batch.
          </p>
          <label class="field">
            <span>Who is taking it</span>
            <select name="teacher_id" required>
              <option value="">Choose a teacher…</option>
              <% teacherOptions.forEach(function (t) { %>
                <option value="<%= t.id %>"><%= t.name %></option>
              <% }); %>
            </select>
          </label>
          <label class="field">
            <span>Why — students see this</span>
            <input type="text" name="note" maxlength="<%= noteMax %>" required
                   placeholder="Herr Seraj away">
          </label>
          <%- include("../../partials/teach-notify", { canEmail: canEmail, verb: "the change of teacher" }) %>
          <p class="muted" style="margin:0;font-size:.78rem">
            The office is told either way.
          </p>
          <button class="btn btn-sm" type="submit">Hand over this class</button>
        </form>
      <% } %>

      <% if (canHandOver && lesson.stand_in_id) { %>
        <form method="post" action="/teach/lesson/<%= lesson.id %>/takeback" class="tl-form">
          <input type="hidden" name="back" value="/teach/batch/<%= batch.id %>/register?date=<%= date %>">
          <p class="muted" style="margin:0;font-size:.84rem">
            <strong><%= lesson.stand_in_name || "Another teacher" %></strong> is taking this class<%
              if (lesson.handover_note) { %> — <%= lesson.handover_note %><% } %>.
          </p>
          <button class="btn btn-sm btn-ghost" type="submit">Take it back</button>
        </form>
      <% } %>

      <form method="post" action="/teach/lesson/<%= lesson.id %>/move" class="tl-form">
        <input type="hidden" name="back" value="/teach/batch/<%= batch.id %>/register?date=<%= date %>">
        <p class="muted" style="margin:0;font-size:.84rem">
          Postpone it. The same lesson moves to a new date and time, and
          the students are told what it moved from.
        </p>
        <div class="tl-row">
          <label class="field">
            <span>New date</span>
            <input type="date" name="date" value="<%= isoIn(lesson.starts_at, batch.timezone) %>" required>
          </label>
          <label class="field">
            <span>New time (<%= batch.timezone || "Europe/Berlin" %>)</span>
            <input type="time" name="time" value="<%= hhmmIn(lesson.starts_at, batch.timezone) %>" required>
          </label>
          <label class="field">
            <span>Minutes</span>
            <input type="number" name="minutes" value="<%= lesson.minutes %>" min="10" max="600" step="5">
          </label>
        </div>
        <label class="field">
          <span>Why it has moved — students see this</span>
          <input type="text" name="note" maxlength="<%= noteMax %>" required
                 placeholder="Moved to Thursday">
        </label>
        <%- include("../../partials/teach-notify", { canEmail: canEmail, verb: "the new time" }) %>
        <button class="btn btn-sm" type="submit">Postpone this class</button>
      </form>
    </details>
  </div>
<% } %>

<%- include("../../partials/teach-shell-foot") %>
