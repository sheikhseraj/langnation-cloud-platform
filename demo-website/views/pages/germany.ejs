<%- include("../partials/head") %>
<%- include("../partials/header") %>

<section class="section-tight">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow"><%= t("nav.germany") %></p>
      <h1><%= t("germany.title") %></h1>
      <p class="lead"><%= t("germany.lead") %></p>
    </div>

    <% groups.forEach(function (g) { %>
      <div style="margin-bottom:3.25rem">
        <h2 style="font-size:clamp(1.35rem,3vw,1.8rem);margin-bottom:1.25rem"><%= g.label %></h2>
        <div class="grid">
          <% g.items.forEach(function (p) { %>
            <a class="card" href="<%= lp('/' + p.slug) %>">
              <%# Every card keeps a media band, image or not, so the titles in
                  a row line up instead of stepping up and down. %>
              <div class="card-media<%= p.image ? '' : ' card-media-blank' %><%= p.diagram ? ' card-media-diagram' : '' %>">
                <% if (p.image) { %>
                  <img src="<%= p.image.src %>"
                       <% if (p.image.srcset) { %>srcset="<%= p.image.srcset %>" sizes="(min-width:1120px) 340px, 92vw"<% } %>
                       width="800" height="500" loading="lazy" decoding="async" alt="">
                <% } else { %>
                  <img src="/icons/crest.png?v=<%= site.assetVersion %>" width="48" height="48" alt="" aria-hidden="true">
                <% } %>
              </div>
              <div class="card-body">
                <h3><%= p.title %></h3>
                <p><%= p.excerpt %></p>
                <div class="card-foot"><span class="go"><%= t("cta.readMore") %> →</span></div>
              </div>
            </a>
          <% }); %>
        </div>
      </div>
    <% }); %>
  </div>
</section>

<%- include("../partials/footer") %>
