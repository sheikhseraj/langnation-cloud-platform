<%- include('../partials/head') %><%- include('../partials/header') %>
<section class="section-tight cm-module cm-public" data-community-public data-join-target="<%= JSON.stringify(typeof communityJoinTarget!=='undefined'?communityJoinTarget:null) %>" data-countries="<%= JSON.stringify(typeof countries!=='undefined'?countries:[]) %>" data-lang="<%= lang %>" data-csrf="<%= communityCsrf %>">
<div class="wrap"><div class="cm-hero"><p class="eyebrow">LangNation Community</p><h1><%= lang==='de'?'Community beitreten':'Join the Community' %></h1><p class="lead"><%= lang==='de'?'Menschen vor Ort kennenlernen, nützliche Informationen austauschen und einander helfen.':'Connect locally, exchange useful information and help one another.' %></p><a class="btn" href="#community-join" hidden data-community-join aria-controls="community-join" aria-expanded="false"><%= lang==='de'?'Beitritt anfragen':'Request to Join' %></a><p hidden data-community-availability role="status"></p></div>
<section class="cm-card cm-community-intro"><h2><%= lang==='de'?'Gemeinsam respektvoll':'A helpful, respectful community' %></h2><p><%= lang==='de'?'Unsere Gruppen helfen Menschen, sich vor Ort zu vernetzen, nützliche Informationen auszutauschen und einander zu unterstützen.':'Our groups are designed to help people connect locally, exchange useful information and support each other.' %></p></section>
<p data-cm-notice role="status" aria-live="polite"></p><div data-cm-content aria-busy="true"><p><%= lang==='de'?'Community wird geladen…':'Loading community…' %></p></div>
</div></section><%- include('../partials/footer') %>