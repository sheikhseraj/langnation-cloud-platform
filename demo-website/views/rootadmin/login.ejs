<!DOCTYPE html>
<html lang="en" data-theme-default data-ground="<%= site.ground %>">
<head>
<%- include("../partials/admin-head", { adTitle: "Root admin", site: site }) %>
</head>
<body>

<%#
  The sign-in page keeps the header but not the sidebar: those links lead
  nowhere useful until you are in, and showing a navigation you cannot
  use reads as a broken page.
%>
<header class="ad-top">
  <a class="brand" href="/" aria-label="LangNation">
    <%- include("../partials/brand", { sub: "Root admin" }) %>
  </a>
  <div class="ad-spacer"></div>
  <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch theme">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" data-icon-sun>
      <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
    </svg>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-icon-moon hidden>
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
    </svg>
  </button>
</header>

<main class="ad-main" style="max-width:440px;margin-inline:auto">
  <div class="ad-card">
    <h2>Sign in</h2>

    <% if (error) { %>
      <p class="notice notice-bad"><%= error %></p>
    <% } %>

    <%#
      Shown even when ROOT_PASSWORD is missing: the message above explains
      why signing in cannot work, whereas an absent form would just look
      like a page that had failed to load.
    %>
    <form class="form" method="post" action="/rootadmin/login">
      <label class="field">
        <span>Password</span>
        <div class="pw" data-password>
          <input type="password" name="password" autocomplete="current-password" autofocus required>
        </div>
      </label>
      <button class="btn" type="submit">Sign in</button>
    </form>
  </div>

  <p class="muted" style="font-size:.85rem">
    This editor changes what the live site shows, including prices.
    For reading enquiries, use <a href="/admin">/admin</a> instead.
  </p>
</main>

<script src="/js/app.js?v=<%= site.assetVersion %>" defer></script>
</body>
</html>
