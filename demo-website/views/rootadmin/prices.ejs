<%#
  Every price on one page.

  Changing the term fee across a dozen courses meant opening a dozen
  course editors, each a long form where the price is three fields
  down — so in practice it was done once and then not again. Three
  columns per course, one Save.

  English rows only. Price is a number, not a translation, and the
  German row of a course carries the same one.
%>
<!DOCTYPE html>
<html lang="en" data-theme-default data-ground="<%= site.ground %>">
<head>
<%- include("../partials/admin-head", { adTitle: "Prices", site: site }) %>
</head>
<body>

<div class="ad-shell">
  <%- include("../partials/admin-side", { adCurrent: "prices", adArea: "content" }) %>

  <div class="ad-body">
    <%- include("../partials/admin-top", {
      adTitle: "Prices",
      adCrumbs: [{ label: "Root admin", href: "/rootadmin" }, { label: "Prices" }],
      adLogout: "/rootadmin/logout",
    }) %>

    <main class="ad-main">

      <% const refusals = typeof refused === "undefined" ? [] : refused; %>
      <% if (saved > 0) { %>
        <p class="notice notice-ok">
          <%= saved %> <%= saved === 1 ? "course" : "courses" %> updated. The live site is already showing this.
        </p>
      <% } else if (saved === 0 && typeof saved === "number" && !refusals.length) { %>
        <p class="notice">Nothing changed, so nothing was saved.</p>
      <% } %>

      <%# Named, because the alternative is a course that quietly did
          not save. That is the failure this whole rule exists for: a
          discount was set, the page said it had worked, and nothing on
          the site ever changed. %>
      <% if (refusals.length) { %>
        <p class="notice notice-bad">
          <%= refusals.length === 1 ? "One course was not saved" : refusals.length + " courses were not saved" %>,
          and <%= refusals.length === 1 ? "it is" : "they are" %> still as
          <%= refusals.length === 1 ? "it was" : "they were" %>:
          <% refusals.forEach(function (r) { %>
            <br><%= r %>
          <% }); %>
        </p>
      <% } %>

      <form method="post" action="/rootadmin/prices">
        <div class="ad-card">
          <h2><%= courses.length %> courses</h2>
          <p class="muted" style="font-size:.85rem;margin-top:-.4rem">
            The discount is what somebody actually pays — the course page
            shows the price struck through with the discount beside it. So
            it has to be <strong>lower</strong> than the price. Leave it
            empty for no discount, and seats empty for no limit.
            Everything else about a course is on its own page.
          </p>

          <%# Said here rather than refused at save time.

              A discount that is not lower than the price is not an
              offer, so the live site ignores it and shows the plain
              price. Silently ignoring it is how somebody sets a
              discount, sees nothing change, and concludes the site is
              broken — which is exactly what happened. %>
          <%
            const wrong = courses.filter((c) =>
              c.discountEur != null && c.priceEur != null &&
              Number(c.discountEur) >= Number(c.priceEur));
          %>
          <% if (wrong.length) { %>
            <p class="notice notice-bad" style="margin:.6rem 0">
              <%= wrong.length === 1 ? "One course has" : wrong.length + " courses have" %>
              a discount that is not lower than the price, so the live site is
              showing the plain price and no offer:
              <%= wrong.map((c) => c.title + " (€" + c.priceEur + " → €" + c.discountEur + ")").join(", ") %>.
            </p>
          <% } %>

          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>Course</th>
                  <th style="width:8rem">Price €</th>
                  <th style="width:8rem">Discount €</th>
                  <th style="width:7rem">Seats</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% courses.forEach(function (c) { %>
                  <tr>
                    <td>
                      <input type="hidden" name="id" value="<%= c.id %>">
                      <strong><%= c.title %></strong>
                      <div class="muted" style="font-size:.8rem">
                        <%= c.level ? c.level + " · " : "" %><%= c.track %><%= c.status !== "published" ? " · " + c.status : "" %>
                      </div>
                    </td>
                    <td>
                      <input class="pz-num" type="number" min="0" step="1"
                             name="price_eur_<%= c.id %>"
                             value="<%= c.priceEur == null ? "" : c.priceEur %>"
                             aria-label="Price for <%= c.title %>">
                    </td>
                    <td>
                      <input class="pz-num<%= (c.discountEur != null && c.priceEur != null && Number(c.discountEur) >= Number(c.priceEur)) ? " pz-wrong" : "" %>"
                             type="number" min="0" step="1"
                             name="discount_eur_<%= c.id %>"
                             value="<%= c.discountEur == null ? "" : c.discountEur %>"
                             aria-label="Discounted price for <%= c.title %>">
                    </td>
                    <td>
                      <input class="pz-num" type="number" min="0" step="1"
                             name="seats_<%= c.id %>"
                             value="<%= c.seats == null ? "" : c.seats %>"
                             aria-label="Seats for <%= c.title %>">
                    </td>
                    <td class="pz-do">
                      <%# Straight to the page a visitor sees, in a new tab,
                          so checking an edit does not mean losing the rest
                          of the form. Only for a published course: the link
                          to an unpublished one is a 404, which reads as the
                          site being broken rather than as the course not
                          being out yet. %>
                      <% if (c.status === "published") { %>
                        <a class="btn btn-sm btn-ghost" target="_blank" rel="noopener"
                           href="/courses/<%= encodeURIComponent(c.slug) %>"
                           title="Open the page a visitor sees">View live</a>
                      <% } %>
                      <a class="btn btn-sm btn-ghost" href="/rootadmin/course/<%= encodeURIComponent(c.slug) %>">Edit</a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>

        <button class="btn" type="submit">Save prices</button>
        <a class="btn btn-ghost" href="/rootadmin">Cancel</a>
      </form>

    </main>
  </div>
</div>

<script src="/js/app.js?v=<%= site.assetVersion %>" defer></script>
</body>
</html>
